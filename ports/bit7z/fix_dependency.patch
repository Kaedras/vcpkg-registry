--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -217,7 +217,8 @@ include( cmake/BuildOptions.cmake )
 include( cmake/CompilerOptions.cmake )

 # dependencies
-include( cmake/Dependencies.cmake )
+find_package(7zip CONFIG REQUIRED)
